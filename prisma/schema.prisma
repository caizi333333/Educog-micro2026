generator client {
  provider = "prisma-client-js"
  // 兼容本地开发（macOS）与 CI/部署环境（Linux）
  binaryTargets = ["native", "darwin-arm64", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // 正式环境使用 PostgreSQL；本地开发也建议通过 docker-compose 启动同构数据库
  url      = env("DATABASE_URL")
}

model User {
  id                 String                  @id @default(cuid())
  email              String                  @unique
  username           String                  @unique
  password           String
  name               String?
  avatar             String?
  role               String                  @default("STUDENT")
  status             String                  @default("ACTIVE")
  studentId          String?                 @unique
  class              String?
  grade              String?
  major              String?
  teacherId          String?                 @unique
  department         String?
  title              String?
  totalPoints        Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  lastLoginAt        DateTime?
  certificates       Certificate[]
  learningPaths      LearningPath[]
  learningProgress   LearningProgress[]
  quizAttempts       QuizAttempt[]
  sessions           Session[]
  achievements       UserAchievement[]
  activities         UserActivity[]
  classEnrollments   ClassEnrollment[]
  experiments        UserExperiment[]
  learningEvents     LearningEvent[]
  pointsTransactions UserPointsTransaction[]
  teachingClasses    ClassGroup[]            @relation("ClassTeacher")
  userProgress       UserProgress?

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([totalPoints])
}

model ClassGroup {
  id             String            @id @default(cuid())
  name           String
  inviteCode     String            @unique
  courseName     String?
  semester       String?
  teacherId      String?
  status         String            @default("ACTIVE")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  teacher        User?             @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments    ClassEnrollment[]
  learningEvents LearningEvent[]

  @@index([teacherId])
  @@index([status])
  @@index([name])
}

model ClassEnrollment {
  id         String     @id @default(cuid())
  userId     String
  classId    String
  role       String     @default("STUDENT")
  status     String     @default("ACTIVE")
  joinedAt   DateTime   @default(now())
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  classGroup ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([userId])
  @@index([classId])
  @@index([status])
}

model LearningEvent {
  id         String      @id @default(cuid())
  userId     String
  classId    String?
  eventType  String
  targetType String
  targetId   String
  moduleId   String?
  chapterId  String?
  experimentId String?
  quizId     String?
  duration   Int?
  progress   Int?
  clientTime DateTime?
  metadata   String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  classGroup ClassGroup? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([classId])
  @@index([eventType])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([userId, eventType])
  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([userId, action])
  @@index([userId, action, createdAt])
}

model UserExperiment {
  id           String    @id @default(cuid())
  userId       String
  experimentId String
  status       String    @default("NOT_STARTED")
  score        Int?
  startedAt    DateTime?
  completedAt  DateTime?
  timeSpent    Int?
  attempts     Int       @default(0)
  lastCode     String?
  results      String?
  feedback     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, experimentId])
  @@index([userId])
  @@index([experimentId])
  @@index([status])
  @@index([userId, status])
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  quizId         String
  score          Float
  totalQuestions Int
  correctAnswers Int
  timeSpent      Int
  answers        String
  startedAt      DateTime
  completedAt    DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
  @@index([score])
  @@index([createdAt])
  @@index([userId, completedAt])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  name          String
  description   String
  icon          String?
  category      String
  unlockedAt    DateTime @default(now())
  progress      Int      @default(100)
  points        Int      @default(0)
  source        String   @default("SYSTEM")
  awardedBy     String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([category])
  @@index([achievementId])
  @@index([userId, category])
}

model LearningPath {
  id            String             @id @default(cuid())
  userId        String
  name          String
  description   String?
  modules       String
  currentModule Int                @default(0)
  totalModules  Int
  status        String             @default("ACTIVE")
  startedAt     DateTime           @default(now())
  completedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress      LearningProgress[]

  @@index([userId])
  @@index([status])
}

model LearningProgress {
  id           String        @id @default(cuid())
  userId       String
  pathId       String?
  moduleId     String
  chapterId    String
  status       String        @default("NOT_STARTED")
  progress     Int           @default(0)
  timeSpent    Int           @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  lastAccessAt DateTime      @default(now())
  notes        String?
  bookmarks    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  learningPath LearningPath? @relation(fields: [pathId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId, chapterId])
  @@index([userId])
  @@index([pathId])
  @@index([status])
  @@index([userId, chapterId])
  @@index([userId, status])
}

model Certificate {
  id            String    @id @default(cuid())
  userId        String
  type          String
  name          String
  description   String?
  courseScore   Float?
  examScore     Float?
  totalScore    Float
  certificateNo String    @unique
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime?
  metadata      String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([certificateNo])
}

model UserPointsTransaction {
  id          String   @id @default(cuid())
  userId      String
  points      Int
  type        String
  description String
  metadata    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model UserProgress {
  id               String   @id @default(cuid())
  userId           String   @unique
  modulesCompleted Int      @default(0)
  totalTimeSpent   Int      @default(0)
  averageScore     Float?
  streakDays       Int      @default(0)
  lastActiveDate   DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastActiveDate])
}

// Knowledge graph nodes mirrored from src/lib/knowledge-points.ts.
// Foundation only — populated by scripts/seed-knowledge.ts. Read/write APIs
// and the teacher editor that mutates this table are a separate slice.
model KnowledgeNode {
  id            String   @id // matches the static knowledge-points id (e.g. "8.1.5")
  name          String
  level         Int      // 1 | 2 | 3
  chapter       Int
  description   String?
  graphNodeId   String?  // legacy curated graph alias used by deep links
  parentId      String?  // matches another KnowledgeNode.id, NOT a FK constraint to allow staged seeding
  resources     Json?    // KnowledgePointResource[] from the static source, verbatim
  prerequisites String[] @default([])  // ids of other KnowledgeNodes this depends on
  appliedIn     String[] @default([])  // experiment refIds where this point is exercised
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([chapter])
  @@index([level])
  @@index([parentId])
  @@index([graphNodeId])
}

model AchievementAuditLog {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  action        String   // GRANT | REVOKE | RECALC
  performedBy   String?
  previousState String?  // JSON
  newState      String?  // JSON
  reason        String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([achievementId])
  @@index([action])
}

// ============================================================================
// OBE 工程教育认证模型
// 支撑链: GraduationRequirement → IndicatorPoint → CourseObjective → AssessmentLink → 评分数据
// ============================================================================

model GraduationRequirement {
  id               String            @id @default(cuid())
  code             String            @unique // e.g. "GR01"
  index            Int               @unique // 1..11
  name             String                    // e.g. "工程知识"
  description      String?
  standardVersion  String            @default("2024")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  indicators       IndicatorPoint[]

  @@index([index])
}

model IndicatorPoint {
  id                      String                @id @default(cuid())
  code                    String                @unique // e.g. "1-3"
  graduationRequirementId String
  subIndex                Int                           // e.g. 3 for GR01 sub-point 3
  description             String                        // e.g. "运用计算知识和工具"
  achievementThreshold    Float                 @default(0.65)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  graduationRequirement   GraduationRequirement @relation(fields: [graduationRequirementId], references: [id], onDelete: Cascade)
  courseObjectives        CourseObjective[]
  grAchievements          GraduationRequirementAchievement[]

  @@unique([graduationRequirementId, subIndex])
  @@index([code])
}

model CourseObjective {
  id                 String            @id @default(cuid())
  code               String            @unique // e.g. "CO1"
  name               String                    // e.g. "掌握8051微控制器基本结构与工作原理"
  description        String?
  indicatorPointId   String
  supportWeight      Float                     // 0.0-1.0, how much this CO contributes to the indicator point
  semester           String?                   // e.g. "2025-2026-1"
  version            Int               @default(1) // CQI versioning
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  indicatorPoint     IndicatorPoint    @relation(fields: [indicatorPointId], references: [id], onDelete: Cascade)
  assessmentLinks    AssessmentLink[]
  achievementRecords CourseObjectiveAchievement[]

  @@index([indicatorPointId])
  @@index([isActive])
}

model AssessmentLink {
  id                  String          @id @default(cuid())
  courseObjectiveId   String
  assessmentType      String          // "QUIZ" | "EXPERIMENT" | "LEARNING_PROGRESS" | "COMPREHENSIVE"
  assessmentTargetId  String          // quizId (e.g. "quiz-ch4"), experimentId (e.g. "exp03"), or chapterId
  weight              Float           // 0.0-1.0, contribution weight within this CO
  maxScore            Float           // 100 for quizzes/experiments, 100 for progress
  chapter             Int?
  description         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  courseObjective     CourseObjective @relation(fields: [courseObjectiveId], references: [id], onDelete: Cascade)

  @@unique([courseObjectiveId, assessmentType, assessmentTargetId])
  @@index([courseObjectiveId])
  @@index([assessmentType, assessmentTargetId])
}

model CourseObjectiveAchievement {
  id                  String          @id @default(cuid())
  userId              String
  courseObjectiveId   String
  semester            String?
  classId             String?
  weightedScoreSum    Float           // Σ(actual_score × weight)
  weightedMaxSum      Float           // Σ(max_score × weight)
  achievementDegree   Float           // weightedScoreSum / weightedMaxSum
  passed              Boolean         // achievementDegree >= threshold
  breakdown           String?         // JSON: { quiz: {score, max, weight}, experiment: {...} }
  calculatedAt        DateTime        @default(now())
  createdAt           DateTime        @default(now())
  courseObjective     CourseObjective @relation(fields: [courseObjectiveId], references: [id], onDelete: Cascade)

  @@unique([userId, courseObjectiveId, semester])
  @@index([userId])
  @@index([courseObjectiveId])
  @@index([passed])
  @@index([userId, courseObjectiveId])
}

model GraduationRequirementAchievement {
  id                     String          @id @default(cuid())
  userId                 String
  indicatorPointId       String
  semester               String?
  classId                String?
  achievementDegree      Float           // weighted average of supporting CO achievements
  passed                 Boolean
  contributingObjectives String?         // JSON: [{coId, coAchievement, weight}]
  calculatedAt           DateTime        @default(now())
  createdAt              DateTime        @default(now())
  indicatorPoint         IndicatorPoint  @relation(fields: [indicatorPointId], references: [id], onDelete: Cascade)

  @@unique([userId, indicatorPointId, semester])
  @@index([userId])
  @@index([indicatorPointId])
  @@index([passed])
}

model CQIReport {
  id                  String          @id @default(cuid())
  semester            String                           // e.g. "2025-2026-1"
  classId             String?
  title               String
  reportType          String                           // "COURSE" | "INDICATOR" | "GRADUATION_REQ"
  targetId            String?
  targetCode          String?                          // e.g. "CO1", "1-3", "GR01"
  averageAchievement  Float?
  passRate            Float?
  totalStudents       Int              @default(0)
  passedStudents      Int              @default(0)
  weakPoints          String?                           // JSON: [{targetId, description, avgScore}]
  strengths           String?                           // JSON: [{targetId, description, avgScore}]
  improvementMeasures String?                           // JSON: [{measure, responsible, deadline}]
  previousMeasures    String?                           // JSON from prior semester
  previousAchievement Float?
  achievementChange   Float?
  status              String           @default("DRAFT") // DRAFT | REVIEWED | APPROVED | CLOSED
  reviewedBy          String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  actionItems         CQIActionItem[]

  @@index([semester])
  @@index([reportType])
  @@index([classId])
  @@index([status])
}

model CQIActionItem {
  id            String    @id @default(cuid())
  cqiReportId   String
  description   String
  category      String    // "CONTENT" | "METHOD" | "RESOURCE" | "ASSESSMENT"
  assignedTo    String?   // teacher userId
  dueDate       DateTime?
  status        String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  result        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  cqiReport     CQIReport @relation(fields: [cqiReportId], references: [id], onDelete: Cascade)

  @@index([cqiReportId])
  @@index([status])
}
